APP_NAME=AtlasScope
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# ---------------------------------------------------------------------------
# AtlasScope
# ---------------------------------------------------------------------------

# Largest archive that may be uploaded, in bytes. The natural limit is 150 MB,
# and it lives in bin/limits.env (bin/php and config/atlas.php both read it) —
# leave this commented out unless you deliberately want a different ceiling.
# ATLAS_MAX_ARCHIVE_BYTES=157286400

# Ceiling for the unpacked source tree (zip-bomb guard). Not the archive size:
# source compresses several times over, so this sits far above 150 MB.
# ATLAS_MAX_EXTRACTED_BYTES=2147483648

# Scans normally run on the "atlas" queue: `php artisan queue:work --queue=atlas`.
# Leave this empty to decide automatically from QUEUE_CONNECTION (sync = inline),
# or force a behaviour: true = always scan inline, false = always queue.
# ATLAS_SYNC_SCANS=

# Stream every scan stage to the console when scanning from the CLI.
ATLAS_VERBOSE_SCANS=false

# Renderer ceilings: bigger graphs are thinned before drawing.
ATLAS_MAX_RENDER_NODES=2500
ATLAS_MAX_RENDER_EDGES=6000

# Show the bundled sample project on the welcome screen.
ATLAS_DEMO_ENABLED=true

# The local assistant (an optional chat panel; see README).
# The model runs on this machine through Ollama, or any runtime that speaks the
# same API. Nothing is sent anywhere and no key is needed.
ATLAS_AI_ENABLED=true
ATLAS_AI_BASE_URL=http://127.0.0.1:11434
# Whatever you have pulled: qwen3:8b (~5 GB) is the default recommendation;
# phi4:14b is better if you have the memory, llama3.2:3b is the fast one.
ATLAS_AI_MODEL=qwen3:8b
# A 14B model thinking on a laptop CPU is not quick.
# ATLAS_AI_TIMEOUT=180
