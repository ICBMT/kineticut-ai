# The natural AtlasScope limit, defined once.
#
# Read by three consumers so they can never disagree:
#   bin/php                 -> the dev server's PHP limits
#   config/atlas.php        -> App\Support\Ini::devBytes('upload_max')
#   App\Support\Ini         -> the numbers the UI prints
#
# 150 MB is the intended ceiling: a Laravel project without vendor/ and
# node_modules/ is a few MB, and even one carrying images, fixtures and PDFs
# rarely passes 20 MB. Anything beyond 150 MB is a mis-zipped vendor/ tree.
#
# post_max_size sits above upload_max_filesize on purpose: the multipart body
# is the file plus its boundaries and the other form fields.
ATLAS_UPLOAD_MAX_DEFAULT=150M
ATLAS_POST_MAX_DEFAULT=160M
ATLAS_MEMORY_LIMIT_DEFAULT=1G
